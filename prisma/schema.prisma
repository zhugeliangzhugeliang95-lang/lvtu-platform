// ── 闲鱼自动询价机器人 ────────────────────────────────────────────────────

enum XianYuTaskStatus {
  PENDING // 等待机器人处理
  SEARCHING // 机器人搜索卖家中
  MESSAGING // 正在发送询价消息
  WAITING_REPLIES // 已发完，等待商家回复
  AUTO_FOLLOWUP // 自动处理中途追问
  COLLECTING // 统一收集回复中
  AI_ANALYZING // AI 正在分析报价
  QUOTED // AI 报价已生成，等待客户决定
  WAITING_HUMAN_CONFIRM // 客户确认后，等待人工接手成交
  NEEDS_HUMAN // 机器人遇到付款/加微信/身份信息等，需要人工介入
  FAILED // 失败
}

model XianYuTask {
  id           String           @id @default(cuid())
  inquiryId    String
  inquiry      InquiryOrder     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  hotelName    String
  city         String
  roomType     String?
  checkInDate  String
  checkOutDate String
  nights       Int
  guestCount   Int              @default(2)
  roomCount    Int              @default(1)
  status       XianYuTaskStatus @default(PENDING)
  sentCount    Int              @default(0)
  aiSummary    String? // AI 生成的报价摘要 JSON
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages XianYuMessage[]
  quotes   XianYuQuote[]

  @@index([status, createdAt])
  @@index([inquiryId])
}

model XianYuMessage {
  id         String     @id @default(cuid())
  taskId     String
  task       XianYuTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sellerId   String
  sellerName String?
  chatUrl    String?
  sentAt     DateTime   @default(now())
  replied    Boolean    @default(false)
  replyText  String?
  repliedAt  DateTime?

  @@index([taskId])
}

model XianYuQuote {
  id                String     @id @default(cuid())
  taskId            String
  task              XianYuTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sellerId          String
  sellerName        String?
  pricePerNight     Int // 元
  totalPrice        Int // 元
  breakfastIncluded Boolean    @default(false)
  cancellable       Boolean    @default(true)
  extraServices     String? // JSON array 字符串
  rawReply          String
  aiParsed          Boolean    @default(false)
  createdAt         DateTime   @default(now())

  @@index([taskId])
}

// ── 旅行社候选供应链 ───────────────────────────────────────────────────

enum SupplierStatus {
  DISCOVERED
  RESEARCHED
  CONTACT_PENDING
  CONTACTED
  QUALIFICATION_PENDING
  VERIFIED
  NEGOTIATING
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
}

enum SupplierType {
  NATIONAL
  GBA_LOCAL
  DESTINATION_DMC
  OVERSEAS_DMC
}

enum SupplierLicenseStatus {
  UNVERIFIED
  VALID
  EXPIRED
  SUSPENDED
  NOT_FOUND
  CONFLICT
}

enum SupplierSourceType {
  REGULATOR
  GOVERNMENT
  CREDIT_SYSTEM
  OFFICIAL_WEBSITE
  OFFICIAL_ACCOUNT
  INDUSTRY_ASSOCIATION
  OTA_OFFICIAL_STORE
  OTHER
}

enum SupplierConfidence {
  HIGH
  MEDIUM
  LOW
}

enum SupplierVerificationStatus {
  PENDING
  CONFIRMED
  QUESTIONED
  REJECTED
}

enum SupplierRiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum SupplierPublicationStatus {
  DRAFT
  APPROVED
  PUBLISHED
  UNPUBLISHED
}

enum SupplierInquiryStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  READY
  CLOSED
  CANCELLED
}

model TravelSupplier {
  id                 String         @id @default(cuid())
  brandName          String
  legalEntityName    String         @unique
  slug               String         @unique
  supplierType       SupplierType
  status             SupplierStatus @default(RESEARCHED)
  summary            String?
  province           String?
  city               String?
  address            String?
  website            String?
  officialAccount    String?
  creditCode         String?        @unique
  internalScore      Int            @default(0)
  isVerified         Boolean        @default(false)
  isPublic           Boolean        @default(false)
  publicContentReady Boolean        @default(false)
  verifiedAt         DateTime?
  publishedAt        DateTime?
  lastReviewedAt     DateTime?
  nextFollowUpAt     DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  brands            SupplierBrand[]
  licenses          SupplierLicense[]
  services          SupplierService[]
  destinations      SupplierDestination[]
  contacts          SupplierContact[]
  sources           SupplierSource[]
  verifications     SupplierVerification[]
  risks             SupplierRiskFlag[]
  interactions      SupplierInteraction[]
  contracts         SupplierContract[]
  publications      SupplierPublication[]
  auditLogs         SupplierAuditLog[]
  inquiryRecipients SupplierInquiryRecipient[]

  @@index([status, isVerified, isPublic])
  @@index([supplierType, province, city])
  @@index([internalScore])
}

model SupplierBrand {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name         String
  relationship String         @default("OPERATED_BY")
  sourceUrl    String?
  createdAt    DateTime       @default(now())

  @@unique([supplierId, name])
}

model SupplierLicense {
  id                 String                @id @default(cuid())
  supplierId         String
  supplier           TravelSupplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  licenseType        String
  licenseNumber      String?               @unique
  legalEntityName    String
  businessScope      String?
  issuingAuthority   String?
  status             SupplierLicenseStatus @default(UNVERIFIED)
  verificationSource String?
  verifiedAt         DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  evidenceUrl        String?
  verifiedBy         String?
  needsManualReview  Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([supplierId, status])
}

model SupplierService {
  id          String         @id @default(cuid())
  supplierId  String
  supplier    TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  sourceUrl   String?
  verified    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@unique([supplierId, code])
  @@index([code, verified])
}

model SupplierDestination {
  id          String         @id @default(cuid())
  supplierId  String
  supplier    TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String
  countryCode String?
  region      String?
  sourceUrl   String?
  verified    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@unique([supplierId, name])
  @@index([name, verified])
}

model SupplierContact {
  id          String         @id @default(cuid())
  supplierId  String
  supplier    TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  contactType String
  label       String?
  value       String
  sourceUrl   String
  verifiedAt  DateTime?
  isPublic    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@unique([supplierId, contactType, value])
}

model SupplierSource {
  id             String             @id @default(cuid())
  supplierId     String
  supplier       TravelSupplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title          String
  url            String
  sourceType     SupplierSourceType
  fields         String
  queriedAt      DateTime
  confidence     SupplierConfidence
  summary        String?
  isAccessible   Boolean            @default(true)
  manualReviewed Boolean            @default(false)
  createdAt      DateTime           @default(now())

  @@unique([supplierId, url, fields])
  @@index([supplierId, confidence])
}

model SupplierVerification {
  id         String                     @id @default(cuid())
  supplierId String
  supplier   TravelSupplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fieldName  String
  status     SupplierVerificationStatus @default(PENDING)
  finding    String?
  sourceUrl  String?
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime                   @default(now())

  @@index([supplierId, status])
}

model SupplierRiskFlag {
  id         String               @id @default(cuid())
  supplierId String
  supplier   TravelSupplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  code       String
  label      String
  severity   SupplierRiskSeverity @default(MEDIUM)
  detail     String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime             @default(now())

  @@unique([supplierId, code])
  @@index([code, resolvedAt])
}

model SupplierInteraction {
  id            String         @id @default(cuid())
  supplierId    String
  supplier      TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  contactMethod String
  contactedAt   DateTime
  contactPerson String?
  channel       String
  outcome       String
  nextStep      String?
  followUpAt    DateTime?
  internalNote  String?
  createdBy     String
  createdAt     DateTime       @default(now())

  @@index([supplierId, contactedAt])
  @@index([followUpAt])
}

model SupplierContract {
  id             String         @id @default(cuid())
  supplierId     String
  supplier       TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status         String         @default("NOT_STARTED")
  contractNumber String?
  validFrom      DateTime?
  validUntil     DateTime?
  inquiryConsent Boolean        @default(false)
  consentChannel String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([supplierId, status])
}

model SupplierPublication {
  id            String                    @id @default(cuid())
  supplierId    String
  supplier      TravelSupplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status        SupplierPublicationStatus @default(DRAFT)
  publicSummary String?
  reviewedBy    String?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  unpublishedAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([supplierId, status])
}

model SupplierAuditLog {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  actorAdminId String
  action       String
  fieldName    String?
  beforeValue  String?
  afterValue   String?
  reason       String?
  createdAt    DateTime       @default(now())

  @@index([supplierId, createdAt])
  @@index([actorAdminId, createdAt])
}

// Future-only inquiry structures. No sender or external automation is wired in phase one.
model SupplierInquiry {
  id              String                @id @default(cuid())
  requirementJson String
  status          SupplierInquiryStatus @default(DRAFT)
  approvedBy      String?
  approvedAt      DateTime?
  idempotencyKey  String?               @unique
  createdBy       String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  recipients SupplierInquiryRecipient[]
}

model SupplierInquiryRecipient {
  id               String          @id @default(cuid())
  inquiryId        String
  inquiry          SupplierInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         TravelSupplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  consentConfirmed Boolean         @default(false)
  status           String          @default("PENDING")
  createdAt        DateTime        @default(now())

  messages  SupplierInquiryMessage[]
  responses SupplierResponse[]

  @@unique([inquiryId, supplierId])
}

model SupplierInquiryMessage {
  id          String                   @id @default(cuid())
  recipientId String
  recipient   SupplierInquiryRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  direction   String
  channel     String
  body        String
  status      String                   @default("DRAFT")
  sentAt      DateTime?
  createdAt   DateTime                 @default(now())

  @@index([recipientId, createdAt])
}

model SupplierResponse {
  id          String                   @id @default(cuid())
  recipientId String
  recipient   SupplierInquiryRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  rawSummary  String
  receivedAt  DateTime
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())

  quoteCandidates SupplierQuoteCandidate[]
}

model SupplierQuoteCandidate {
  id         String           @id @default(cuid())
  responseId String
  response   SupplierResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  currency   String           @default("CNY")
  amount     Int?
  priceText  String?
  terms      String?
  isReviewed Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([responseId, isReviewed])
}

// ─── 旅游通 · 第一代 AI 旅行顾问 ────────────────────────────────────────

enum AIConversationStatus {
  ACTIVE
  HANDOFF_REQUESTED
  HUMAN_TAKEN_OVER
  CLOSED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIModelTask {
  MAIN_CHAT
  COMPLEX_PLAN
  EMBEDDING
  RERANK
  LOCAL_FALLBACK
}

enum AIKnowledgeCategory {
  DESTINATION
  HOTEL
  ITINERARY
  FAQ
}

model AIConversation {
  id              String               @id @default(cuid())
  sessionKey      String               @unique
  userId          String?
  status          AIConversationStatus @default(ACTIVE)
  profileJson     String               @default("{}")
  summary         String?
  tagsJson        String               @default("[]")
  highValue       Boolean              @default(false)
  handoffReason   String?
  assignedAdminId String?
  humanTakeoverAt DateTime?
  lastMessageAt   DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  messages   AIChatMessage[]
  modelCalls AIModelCall[]
  handoffs   AIHandoff[]

  @@index([status, lastMessageAt])
  @@index([highValue, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model AIChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  modelName      String?
  taskType       AIModelTask?
  sourceIdsJson  String         @default("[]")
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AIModelCall {
  id             String          @id @default(cuid())
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  taskType       AIModelTask
  modelName      String
  provider       String
  latencyMs      Int
  success        Boolean         @default(true)
  inputTokens    Int?
  outputTokens   Int?
  errorCode      String?
  createdAt      DateTime        @default(now())

  @@index([taskType, createdAt])
  @@index([conversationId, createdAt])
}

model AIHandoff {
  id              String         @id @default(cuid())
  conversationId  String
  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerName    String?
  contact         String?
  summary         String
  status          String         @default("PENDING")
  assignedAdminId String?
  handledAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([conversationId, createdAt])
}

model AIKnowledgeDocument {
  id           String              @id @default(cuid())
  category     AIKnowledgeCategory
  title        String
  city         String?
  content      String
  keywordsJson String              @default("[]")
  metadataJson String              @default("{}")
  embeddingRef String?
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now())
